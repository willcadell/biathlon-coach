{
  "name": "biathlon-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "npm run test:logic && npm run test:sensor",
    "typecheck": "tsc -b",
    "cv-check": "esbuild test/cv-check.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/cv-check.mjs && node node_modules/.cache/cv-check.mjs",
    "cv-progress": "esbuild test/cv-progress.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/cv-progress.mjs && node node_modules/.cache/cv-progress.mjs",
    "cv-diagnose": "esbuild test/cv-diagnose.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/cv-diagnose.mjs && node node_modules/.cache/cv-diagnose.mjs",
    "cv-sweep": "esbuild test/cv-sweep.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/cv-sweep.mjs && node node_modules/.cache/cv-sweep.mjs",
    "cv-synth-library": "esbuild test/synth/library.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/synth-library.mjs && node node_modules/.cache/synth-library.mjs",
    "cv-synth-generate": "esbuild test/synth/generate.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/synth-generate.mjs && node node_modules/.cache/synth-generate.mjs",
    "cv-synth-learn": "esbuild test/synth/learn.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/synth-learn.mjs && node node_modules/.cache/synth-learn.mjs",
    "cv-tune": "esbuild test/cv-tune.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/cv-tune.mjs && node node_modules/.cache/cv-tune.mjs",
    "test:logic": "esbuild test/logic.ts --bundle --format=esm --platform=node --log-level=error --outfile=node_modules/.cache/logic.mjs && node node_modules/.cache/logic.mjs",
    "test:sensor": "esbuild test/sensor.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/sensor.mjs && node node_modules/.cache/sensor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.116.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jimp": "^1.6.1",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
