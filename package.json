{
  "name": "biathlon-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "esbuild test/logic.ts --bundle --format=esm --platform=node --log-level=error --outfile=node_modules/.cache/logic.mjs && node node_modules/.cache/logic.mjs",
    "typecheck": "tsc -b",
    "cv-check": "esbuild test/cv-check.ts --bundle --format=esm --platform=node --packages=external --log-level=error --outfile=node_modules/.cache/cv-check.mjs && node node_modules/.cache/cv-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.116.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jimp": "^1.6.1",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
